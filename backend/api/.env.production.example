# Club Agelai - ejemplo de variables para produccion (Plesk)
# Copiar a .env.local en el servidor y completar valores reales.
# Nunca subir secretos reales a Git.

AGELAI_DB_HOST="localhost"
AGELAI_DB_PORT="3306"
AGELAI_DB_NAME="agelaigym_prod"
AGELAI_DB_USER="agelaigym_user"
AGELAI_DB_PASS="CAMBIAR_ESTA_PASSWORD"

AGELAI_BASE_URL="https://dash.agelaigym.es"
AGELAI_APP_SECRET="CAMBIAR_POR_SECRETO_LARGO_ALEATORIO"

AGELAI_GOOGLE_CLIENT_ID=""
AGELAI_GOOGLE_CLIENT_SECRET=""
AGELAI_GOOGLE_REDIRECT_URI="https://dash.agelaigym.es/oauth/google/callback"

AGELAI_SMTP_HOST=""
AGELAI_SMTP_PORT="587"
AGELAI_SMTP_SECURE="tls"
AGELAI_SMTP_USER=""
AGELAI_SMTP_PASS=""
AGELAI_SMTP_FROM_EMAIL=""
AGELAI_SMTP_FROM_NAME="Club Agelai"
